# API
PORT=8787
# Where brands, briefs, pages and leads are stored (data/brands, data/briefs, data/pages, data/submissions) and where confirmed brand kits are written (relative to the repo root).
LPH_DATA_DIR=data
LPH_OUTPUT_DIR=brands
# Allow importing localhost / private-network URLs (needed for the fixture site). Never set this in production.
LPH_ALLOW_PRIVATE_URLS=0
# Use a specific Chromium build instead of Playwright's download.
# LPH_CHROMIUM_PATH=/path/to/chrome

# Briefs (phase 2). With an Anthropic API key, Claude writes the brief; without one, an offline template does.
# ANTHROPIC_API_KEY=
# LPH_BRIEF_GENERATOR=claude   # or "template" to force the offline writer
# LPH_BRIEF_MODEL=claude-opus-5-5

# Connect an SEO/AEO tool through one HTTP endpoint (see docs/seo-providers.md). Without one, briefs use best practices.
# LPH_SEO_ENDPOINT=https://example.com/seo-research
# LPH_SEO_NAME=Semrush
# LPH_SEO_TOKEN=

# Pages (phase 3). The same rule as briefs: Claude with an API key, the offline template without.
# LPH_PAGE_GENERATOR=claude   # or "template"
# LPH_PAGE_MODEL=claude-opus-5-5   # defaults to LPH_BRIEF_MODEL

# Lead forms (see docs/pages.md). Where leads go is set per page in the studio; secrets stay here.
# LPH_WEBHOOK_SECRET=        # signs webhook posts (x-lph-signature)
# HUBSPOT_ACCESS_TOKEN=      # a HubSpot private app token: uses the authenticated Forms API endpoint

# Publishing (phase 4, see docs/publish.md). Without a repo, pages download as a Cloudflare Pages project.
# LPH_GITHUB_REPO=acme/www          # the company's site repo
# LPH_GITHUB_TOKEN=                 # fine-grained token for that repo only: Contents and Pull requests, read and write
# LPH_GITHUB_BASE=main
# LPH_GITHUB_REVIEWERS=ana,acme/web # users or org/team, asked to review pull requests that need it
# LPH_GITHUB_API_URL=               # GitHub Enterprise Server only, e.g. https://github.example.com/api/v3
# LPH_PREVIEW_URL=https://{branch}.acme-www.pages.dev   # where the host previews a branch
# LPH_SITE_ORIGIN=https://www.acme.com                  # overrides origin in the repo's lph.json
# LPH_PUBLISH_OVERRIDE=off          # stops people publishing or downloading a page the checks blocked (on by default)
# LPH_FORM_ENDPOINT=                # post forms to the studio's API (its origin) instead of the site's function

# MCP server and `pnpm try` (see docs/mcp.md). Without LPH_API_URL they run the API in their own process.
# LPH_API_URL=http://localhost:8787
# LPH_PORT=8788                     # where the in-process API serves preview links (a free port by default)
