 "components": {
  "Button": {
   "import": "import { Button } from '@lph/helm-study'",
   "props": {
    "variant": {
     "type": [
      "primary",
      "secondary"
     ],
     "default": "primary",
     "rule": "one primary per view"
    },
    "size": {
     "type": [
      "default",
      "compact"
     ],
     "default": "default",
     "rule": "compact only in navigation and dense rows"
    },
    "href": {
     "type": "string",
     "rule": "set it for navigation (renders <a>); leave it out for actions (renders <button>)"
    },
    "arrow": {
     "type": "boolean",
     "default": "true with href, false without"
    },
    "disabled": {
     "type": "boolean",
     "rule": "buttons only; for links use aria-disabled"
    }
   },
   "avoid": [
    "two primary buttons side by side",
    "custom colours via style or className: use a variant or ask for a new token"
   ]
  },
  "Link": {
   "import": "import { Link } from '@lph/helm-study'",
   "props": {
    "variant": {
     "type": [
      "inline",
      "callout"
     ],
     "default": "inline",
     "rule": "callout stands alone with the arrow; inline is inside a sentence and stays underlined"
    },
    "href": {
     "type": "string",
     "required": true
    }
   }
  }
 },
