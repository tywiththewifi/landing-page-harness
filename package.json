{
  "name": "landing-page-harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @lph/api --filter @lph/studio dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "extract": "pnpm --filter @lph/extractor exec tsx src/cli.ts",
    "fixture": "node scripts/serve-fixture.mjs",
    "site-mcp": "pnpm --filter @lph/site-mcp exec tsx src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
