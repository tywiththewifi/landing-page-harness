  "content": [
    {
      "url": "https://northloop.example/",
      "title": "Northloop | Workflow automation for ops teams",
      "description": "Northloop connects your CRM, billing and support tools so ops teams ship workflows in days, not quarters.",
      "lang": "en",
      "headings": [
        {
          "level": 1,
          "text": "Automate the work between your tools"
        },
        {
          "level": 2,
          "text": "Built for teams without an automation engineer"
        },
        {
          "level": 3,
          "text": "Lead routing"
        },
        {
          "level": 3,
          "text": "Billing sync"
        },
        {
          "level": 3,
          "text": "Support triage"
        },
        {
          "level": 2,
          "text": "Trusted by 400 ops teams"
        },
        {
          "level": 4,
          "text": "SOC 2 Type II"
        },
        {
          "level": 4,
          "text": "99.95% uptime"
        },
        {
          "level": 4,
          "text": "300+ connectors"
        },
        {
          "level": 2,
          "text": "Talk to us"
        }
      ],
      "paragraphs": [
        "Northloop connects your CRM, billing and support tools so ops teams ship workflows in days, not quarters.",
        "Templates for the workflows every revenue team rebuilds from scratch.",
        "Send every new lead to the right owner in seconds, with enrichment on the way.",
        "Keep Stripe and your CRM in step, with no spreadsheets in the middle.",
        "Tag, prioritise and route tickets before anyone opens the queue."
      ],
      "ctas": [
        "Book a demo",
        "Start free"
      ]
    },
    {
      "url": "https://northloop.example/platform.html",
      "title": "Platform | Northloop",
      "description": "",
      "lang": "en",
      "headings": [
        {
          "level": 1,
          "text": "One canvas for every workflow"
        },
        {
          "level": 2,
          "text": "How it works"
